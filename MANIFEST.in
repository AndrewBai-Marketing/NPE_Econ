include BENCHMARKS.md
include CHANGELOG.md
include CITATION.cff
include CONTRIBUTING.md
include LICENSE
include README.md
include SECURITY.md
include pyproject.toml

recursive-include src/structnpe *.py *.md *.yaml *.csv
include examples/quickstart.py
include examples/custom_model.py
recursive-include examples/assets *

prune benchmarks
prune build
prune dist
prune docs
prune replication
prune research
prune tests
prune validation

global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.pt
global-exclude *.pth
global-exclude *.ckpt
global-exclude .DS_Store
